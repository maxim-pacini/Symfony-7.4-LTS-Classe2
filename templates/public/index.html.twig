{% extends 'base.html.twig' %}

{% block title %}Accueil!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
{# pour afficher des variables on utilise {{ }}, puor effectuer une actions on utilise {% %} #}
    <h1>salut {{ name }}, tu es sur le controleur {{ controller_name }}! ✅</h1>
    {# twig dans symfony protège par défaut contre les attaques XSS #}
    <p>script executé</p>
    {{ scriptok|raw }} {# raw execute de manière brute #}
    <p> script bloqué</p>
    {{ xss }} {# mais par défault c'est bloqué  #}

    {% include 'public/inc/menu.html.twig' %}
    
</div>
{% endblock %}
